<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.parktrac.background.refresh</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>ThrillTrack</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSCameraUsageDescription</key>
	<string>ThrillTrack uses the camera to photograph your parking row sign so you can find your car later.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ThrillTrack uses your location to center the map on the park you're visiting and to save where you parked.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>parking</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Find My Car</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Or save where you parked</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>car.fill</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>plan</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>My Day</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>list.bullet.clipboard</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>waittimes</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Wait Times</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>clock.fill</string>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
